<% html_title("SFMS Quarterly / SFS Annual Reports") -%>

<div class="contextual">
  <%= link_to sprite_icon('download', "Export Excel"), periodic_project_audit_reports_path(@project,
        format: :xlsx,
        system: @system,
        start_date: @from_date.to_date.iso8601,
        end_date: @to_date.to_date.iso8601),
      class: "icon icon-download" %>
  <%= link_to sprite_icon('cancel', "Back to Reports"), project_audit_reports_path(@project), class: "icon icon-cancel" %>
</div>

<h2>SFMS Quarterly / SFS Annual Reports</h2>

<%
  # Active window dates, used to prefill the override pickers so they always
  # reflect the current selection.
  from_iso = @from_date.to_date.iso8601
  to_iso   = @to_date.to_date.iso8601
  # Switching system resets to that system's default window (avoids carrying
  # one report's dates into the other).
  sfms_url = periodic_project_audit_reports_path(@project, system: 'sfms')
  sfs_url  = periodic_project_audit_reports_path(@project, system: 'sfs')
%>
<%= form_tag(periodic_project_audit_reports_path(@project), method: :get, id: "periodic-filter-form") do %>
  <fieldset class="box">
    <legend>Query Period</legend>

    <p>
      <%= label_tag :system, "System" %>
      <%= select_tag :system,
            options_for_select([['SFMS (Oracle/SFMS)', 'sfms'], ['SFS', 'sfs']], @system.to_s),
            id: "periodic-system",
            data: { 'sfms-url': sfms_url, 'sfs-url': sfs_url } %>
    </p>

    <% if @system == :sfms %>
      <% selected_q = @sfms_quarters.index { |q| q[:from].to_date == @from_date.to_date && q[:to].to_date == @to_date.to_date } %>
      <p>
        <%= label_tag :periodic_quarter, "Audit Quarter" %>
        <select id="periodic-quarter">
          <% if selected_q.nil? %>
            <option value="" selected>Custom range</option>
          <% end %>
          <% @sfms_quarters.each_with_index do |q, i| %>
            <option value="<%= i %>"
                    data-from="<%= q[:from].to_date.iso8601 %>"
                    data-to="<%= q[:to].to_date.iso8601 %>"
                    <%= 'selected' if i == selected_q %>><%= q[:label] %></option>
          <% end %>
        </select>
      </p>
      <p>
        <%= label_tag :start_date, "From" %>
        <%= date_field_tag :start_date, from_iso, id: "periodic-start", class: "date-picker auto-submit" %>
      </p>
      <p>
        <%= label_tag :end_date, "To" %>
        <%= date_field_tag :end_date, to_iso, id: "periodic-end", class: "date-picker auto-submit" %>
      </p>
    <% else %>
      <div class="mode-row">
        <span class="mode-row-label">Mode</span>
        <label class="mode-radio">
          <%= radio_button_tag :mode, 'end_only', @sfs_mode == 'end_only', class: 'sfs-mode-toggle' %>
          <span>End date only</span>
        </label>
        <label class="mode-radio">
          <%= radio_button_tag :mode, 'range', @sfs_mode == 'range', class: 'sfs-mode-toggle' %>
          <span>Custom range</span>
        </label>
      </div>

      <div id="sfs-endonly-block" style="<%= 'display:none;' unless @sfs_mode == 'end_only' %>">
        <p>
          <%= label_tag :end_date, "End Date" %>
          <%= date_field_tag :end_date, to_iso, id: "sfs-endonly-end",
              class: "date-picker auto-submit", disabled: @sfs_mode != 'end_only' %>
          <span class="info-text">Start date auto-selects to one year prior.</span>
        </p>
      </div>

      <div id="sfs-range-block" style="<%= 'display:none;' unless @sfs_mode == 'range' %>">
        <p>
          <%= label_tag :start_date, "Start Date" %>
          <%= date_field_tag :start_date, from_iso, id: "sfs-range-start",
              class: "date-picker auto-submit", disabled: @sfs_mode != 'range' %>
        </p>
        <p>
          <%= label_tag :end_date, "End Date" %>
          <%= date_field_tag :end_date, to_iso, id: "sfs-range-end",
              class: "date-picker auto-submit", disabled: @sfs_mode != 'range' %>
        </p>
      </div>
    <% end %>

    <p>
      <label></label>
      <%= link_to "Reset to Default", periodic_project_audit_reports_path(@project, system: @system), class: "button-small" %>
    </p>
  </fieldset>
<% end %>

<script>
  (function () {
    var form = document.getElementById('periodic-filter-form');
    if (!form) return;

    // Switching system resets to that system's default window.
    var systemSelect = document.getElementById('periodic-system');
    if (systemSelect) {
      systemSelect.addEventListener('change', function () {
        window.location = this.value === 'sfs'
          ? this.dataset.sfsUrl : this.dataset.sfmsUrl;
      });
    }

    // Any date field auto-applies the report on change (no Apply button).
    form.querySelectorAll('.auto-submit').forEach(function (input) {
      input.addEventListener('change', function () { form.submit(); });
    });

    // SFMS: selecting a quarter fills the From/To pickers and applies.
    var quarter = document.getElementById('periodic-quarter');
    var startInput = document.getElementById('periodic-start');
    var endInput = document.getElementById('periodic-end');
    if (quarter) {
      quarter.addEventListener('change', function () {
        var opt = this.options[this.selectedIndex];
        if (opt && opt.dataset.from) {
          startInput.value = opt.dataset.from;
          endInput.value = opt.dataset.to;
          form.submit();
        }
      });
    }

    // SFS: two date-selection modes toggled by radio buttons. Enabling the
    // active block's inputs (and disabling the other's) so only its dates post,
    // then submitting re-applies the report under the chosen mode. In end-only
    // mode the start date is computed server-side.
    var modeRadios = document.querySelectorAll('.sfs-mode-toggle');
    var endOnlyBlock = document.getElementById('sfs-endonly-block');
    var rangeBlock = document.getElementById('sfs-range-block');
    if (modeRadios.length && endOnlyBlock && rangeBlock) {
      var applySfsMode = function (mode) {
        var endOnly = mode === 'end_only';
        endOnlyBlock.style.display = endOnly ? '' : 'none';
        rangeBlock.style.display = endOnly ? 'none' : '';
        endOnlyBlock.querySelectorAll('input[type="date"]').forEach(function (i) { i.disabled = !endOnly; });
        rangeBlock.querySelectorAll('input[type="date"]').forEach(function (i) { i.disabled = endOnly; });
      };
      modeRadios.forEach(function (radio) {
        radio.addEventListener('change', function () {
          if (!this.checked) return;
          applySfsMode(this.value);
          form.submit();
        });
      });
    }
  })();
</script>

<% if @report_count.nil? || @report_count.zero? %>
  <p class="nodata">
    No closed <%= @system.to_s.upcase %> tickets found between
    <%= @from_date.to_date.strftime('%Y-%m-%d') %> and <%= @to_date.to_date.strftime('%Y-%m-%d') %>.
  </p>
<% else %>
  <p class="report-info">
    Showing <%= pluralize(@report_count, "closed #{@system.to_s.upcase} ticket") %>
    closed between <%= @from_date.to_date.strftime('%Y-%m-%d') %> and <%= @to_date.to_date.strftime('%Y-%m-%d') %>.
  </p>

  <div class="periodic-report-table-wrapper">
  <table class="list issues periodic-report-table <%= sort_css_classes %>">
    <thead>
      <tr>
        <%= sort_header_tag('request_code', caption: 'RequestType') %>
        <%= sort_header_tag('user_name', caption: 'FullName', class: 'holder-col') %>
        <%= sort_header_tag('user_uid', caption: 'Userid', class: 'holder-col') %>
        <%= sort_header_tag('office', caption: 'Office', class: 'holder-col') %>
        <%= sort_header_tag('created_on', caption: 'EntryDate', class: 'date-col') %>
        <%= sort_header_tag('closed_on', caption: 'CompletedDate', default_order: 'desc', class: 'date-col') %>
        <%= sort_header_tag('issue_id', caption: 'SenDevNumber', class: 'ticket-col') %>
        <%= sort_header_tag('subject', caption: 'Subject') %>
      </tr>
    </thead>
    <tbody>
      <% @report_data.each do |row| %>
        <tr>
          <td><%= row[:request_code] || '—' %></td>
          <td><%= row[:user_name] || '—' %></td>
          <td><%= row[:user_uid] || '—' %></td>
          <td><%= row[:office] || '—' %></td>
          <td class="date-col"><%= row[:created_on]&.strftime('%Y-%m-%d') || '—' %></td>
          <td class="date-col"><%= row[:closed_on]&.strftime('%Y-%m-%d') || '—' %></td>
          <td class="ticket-col">
            <%= link_to "##{row[:issue_id]}", issue_path(row[:issue_id]), target: '_blank' %>
          </td>
          <td><%= row[:subject] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>

  <span class="pagination"><%= pagination_links_full @report_pages, @report_count %></span>
<% end %>

<style>
  #periodic-filter-form {
    margin-bottom: 2em;
  }

  #periodic-filter-form fieldset.box {
    padding: 1em;
  }

  #periodic-filter-form p {
    display: flex;
    align-items: center;
    gap: 1em;
    margin: 0.5em 0;
  }

  #periodic-filter-form label {
    min-width: 150px;
    font-weight: bold;
  }

  #periodic-filter-form .date-picker {
    padding: 0.4em;
    border: 1px solid #ccc;
    border-radius: 3px;
    font-size: 0.95em;
  }

  /* Wide enough that the longest option ("SFMS (Oracle/SFMS)") fits and the
     native dropdown arrow stays visible. */
  #periodic-system {
    min-width: 14em;
  }

  #periodic-filter-form .mode-row {
    display: flex;
    align-items: center;
    gap: 1em;
    margin: 0.5em 0 1em 0;
  }

  #periodic-filter-form .mode-row-label {
    min-width: 150px;
    font-weight: bold;
  }

  #periodic-filter-form .mode-radio {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-width: 0;
    font-weight: normal;
    cursor: pointer;
  }

  #periodic-filter-form .mode-radio input[type="radio"] {
    margin: 0;
  }

  #periodic-filter-form .info-text {
    font-size: 0.9em;
    color: #666;
  }

  .report-info {
    margin-bottom: 1em;
    padding: 0.5em;
    background-color: #f0f0f0;
    border-left: 3px solid #169;
  }

  .pagination {
    display: block;
    margin-top: 1.5em;
  }

  .nodata {
    padding: 2em;
    text-align: center;
    background-color: #f9f9f9;
    border: 1px solid #ddd;
    color: #666;
  }

  .periodic-report-table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
    border: 1px solid #e0e0e0;
  }

  .periodic-report-table {
    min-width: 1000px;
    width: auto;
  }

  .periodic-report-table thead th {
    white-space: normal;
    vertical-align: bottom;
    line-height: 1.25;
    text-align: center;
    text-indent: 0;
  }

  .periodic-report-table thead th.date-col,
  .periodic-report-table tbody td.date-col,
  .periodic-report-table thead th.ticket-col,
  .periodic-report-table tbody td.ticket-col {
    white-space: nowrap;
  }

  .periodic-report-table thead th.holder-col {
    max-width: 9em;
  }
</style>
