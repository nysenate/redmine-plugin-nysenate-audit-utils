<% html_title(l(:label_audit_weekly_report)) -%>

<div class="contextual">
  <%= link_to sprite_icon('download', "Export Excel"), weekly_project_audit_reports_path(@project,
        format: :xlsx,
        start_date: @from_date.to_date.iso8601,
        end_date: @to_date.to_date.iso8601,
        update_type: @update_type),
      class: "icon icon-download" %>
  <%= link_to sprite_icon('cancel', "Back to Reports"), project_audit_reports_path(@project), class: "icon icon-cancel" %>
</div>

<h2>Weekly Report</h2>

<%
  # Prev/Next snap to whole Sun–Sat calendar weeks around the displayed window
  # (#18838). Each nav link carries the active Update Type filter.
  current_week_start = @from_date.to_date.beginning_of_week(:sunday)
  prev_week_start = current_week_start - 7
  next_week_start = current_week_start + 7
  filter_phrase = NysenateAuditUtils::Reporting::CsvGenerator.weekly_filter_phrase(@update_type)
%>

<%= form_tag(weekly_project_audit_reports_path(@project), method: :get, id: "weekly-filter-form") do %>
  <fieldset class="box">
    <legend>Report Filters</legend>

    <p>
      <%= label_tag :start_date, "From" %>
      <%= date_field_tag :start_date, @from_date.to_date.iso8601, class: "date-picker",
            onchange: "this.form.requestSubmit();" %>
    </p>
    <p>
      <%= label_tag :end_date, "To" %>
      <%= date_field_tag :end_date, @to_date.to_date.iso8601, class: "date-picker",
            onchange: "this.form.requestSubmit();" %>
    </p>
    <%
      prev_week_url = weekly_project_audit_reports_path(@project,
        start_date: prev_week_start.iso8601, end_date: (prev_week_start + 6).iso8601,
        update_type: @update_type)
      next_week_url = weekly_project_audit_reports_path(@project,
        start_date: next_week_start.iso8601, end_date: (next_week_start + 6).iso8601,
        update_type: @update_type)
      next_week_disabled = next_week_start > Date.current.beginning_of_week(:sunday)
    %>
    <p class="week-nav-row">
      <label>Jump by week</label>
      <%= button_tag "« Prev Week", type: "button", class: "button-small",
            title: "Previous calendar week",
            onclick: "window.location='#{j prev_week_url}';" %>
      <%= button_tag "Next Week »", type: "button", class: "button-small",
            title: "Next calendar week", disabled: next_week_disabled,
            onclick: "window.location='#{j next_week_url}';" %>
    </p>

    <p>
      <%= label_tag :update_type, "Update Type" %>
      <%= select_tag :update_type,
            options_for_select(
              [['All Updates', 'all'], ['Opened', 'opened'], ['Closed', 'closed'], ['Other Updates', 'other']],
              @update_type
            ),
            class: "date-picker",
            onchange: "this.form.requestSubmit();" %>
    </p>

    <p>
      <label></label>
      <% weekly_at_default = params[:start_date].blank? && params[:end_date].blank? && params[:update_type].blank? %>
      <% if weekly_at_default %>
        <span class="button-small disabled-link">Reset to Default</span>
      <% else %>
        <%= link_to "Reset to Default", weekly_project_audit_reports_path(@project), class: "button-small" %>
      <% end %>
    </p>
  </fieldset>
<% end %>

<% if @report_count.nil? || @report_count.zero? %>
  <p class="nodata"><%= NysenateAuditUtils::Reporting::CsvGenerator.weekly_no_entries(@update_type) %></p>
<% else %>
  <p class="report-info">
    Showing <%= pluralize(@report_count, "#{filter_phrase} ticket") %>
    between <%= @from_date.to_date.strftime('%Y-%m-%d') %> and <%= @to_date.to_date.strftime('%Y-%m-%d') %>.
  </p>

  <div class="weekly-report-table-wrapper">
  <table class="list issues weekly-report-table <%= sort_css_classes %>">
    <thead>
      <tr>
        <%= sort_header_tag('updated_on', caption: 'Updated On', default_order: 'desc', class: 'date-col') %>
        <%= sort_header_tag('created_on', caption: 'Open Date', class: 'date-col') %>
        <%= sort_header_tag('closed_on', caption: 'Closed Date', class: 'date-col') %>
        <%= sort_header_tag('issue_id', caption: 'Ticket #', class: 'ticket-col') %>
        <%= sort_header_tag('status', caption: 'Ticket Status') %>
        <%= sort_header_tag('subject', caption: 'Subject') %>
        <%= sort_header_tag('request_code', caption: 'Request Code') %>
        <%= sort_header_tag('user_name', caption: 'Account Holder Name', class: 'holder-col') %>
        <%= sort_header_tag('user_uid', caption: 'Account Holder Username', class: 'holder-col') %>
        <%= sort_header_tag('office', caption: 'Account Holder Office', class: 'holder-col') %>
        <%= sort_header_tag('user_type', caption: 'Account Holder Type', class: 'holder-col') %>
        <%= sort_header_tag('user_id', caption: 'Account Holder ID', class: 'holder-col') %>
      </tr>
    </thead>
    <tbody>
      <% @report_data.each do |row| %>
        <tr>
          <td class="date-col"><%= row[:updated_on]&.strftime('%Y-%m-%d %H:%M') || '—' %></td>
          <td class="date-col"><%= row[:created_on]&.strftime('%Y-%m-%d') || '—' %></td>
          <td class="date-col"><%= row[:closed_on]&.strftime('%Y-%m-%d') || '—' %></td>
          <td class="ticket-col">
            <%= link_to "##{row[:issue_id]}", issue_path(row[:issue_id]), target: '_blank' %>
          </td>
          <td><%= row[:status] %></td>
          <td><%= row[:subject] %></td>
          <td><%= row[:request_code] || '—' %></td>
          <td><%= row[:user_name] || '—' %></td>
          <td><%= row[:user_uid] || '—' %></td>
          <td><%= row[:office] || '—' %></td>
          <td><%= row[:user_type] || '—' %></td>
          <td><%= row[:user_id] || '—' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>

  <span class="pagination"><%= pagination_links_full @report_pages, @report_count %></span>
<% end %>

<style>
  #weekly-filter-form fieldset.box {
    padding: 1em;
    margin-bottom: 1em;
  }

  #weekly-filter-form p {
    display: flex;
    align-items: center;
    gap: 1em;
    margin: 0.5em 0;
  }

  #weekly-filter-form label {
    min-width: 150px;
    font-weight: bold;
  }

  #weekly-filter-form .date-picker {
    padding: 0.4em;
    border: 1px solid #ccc;
    border-radius: 3px;
    font-size: 0.95em;
  }

  #weekly-filter-form .week-nav-row button.button-small {
    margin: 0;
    white-space: nowrap;
    box-sizing: border-box;
    vertical-align: middle;
  }

  /* Redmine's .button-small doesn't restyle the native disabled state, so the
     "Next Week" button looked active even with disabled="disabled". */
  #weekly-filter-form .week-nav-row button.button-small:disabled {
    opacity: 0.4;
    cursor: default;
    pointer-events: none;
  }

  .disabled-link {
    opacity: 0.4;
    cursor: default;
    pointer-events: none;
  }

  .report-info {
    margin-bottom: 1em;
    padding: 0.5em;
    background-color: #f0f0f0;
    border-left: 3px solid #169;
  }

  .pagination {
    display: block;
    margin-top: 1.5em;
  }

  .nodata {
    padding: 2em;
    text-align: center;
    background-color: #f9f9f9;
    border: 1px solid #ddd;
    color: #666;
  }

  .weekly-report-table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
    border: 1px solid #e0e0e0;
  }

  .weekly-report-table {
    min-width: 1100px;
    width: auto;
  }

  .weekly-report-table thead th {
    white-space: normal;
    vertical-align: bottom;
    line-height: 1.25;
    text-align: center;
    text-indent: 0;
  }

  .weekly-report-table thead th a,
  .weekly-report-table thead th a.sort,
  .weekly-report-table thead th a.icon {
    white-space: normal;
    text-indent: 0;
    text-align: center;
    display: inline;
    padding-right: 0;
    background: none;
  }

  .weekly-report-table thead th a .icon-svg {
    display: inline;
    vertical-align: middle;
  }

  /* On inactive sort headers, Redmine still emits an empty <svg> before the
     label. Its reserved width creates a phantom hanging indent when the
     header text wraps. Hide it (and the label's left margin) so wrapped
     lines align cleanly. */
  .weekly-report-table thead th a:not(.icon) .icon-svg {
    display: none;
  }
  .weekly-report-table thead th a:not(.icon) .icon-label {
    margin-left: 0;
  }

  /* Ticket # header link must stay on one line */
  .weekly-report-table thead th.ticket-col,
  .weekly-report-table thead th.ticket-col a,
  .weekly-report-table thead th.ticket-col a.sort {
    white-space: nowrap;
  }

  .weekly-report-table tbody td {
    overflow-wrap: normal;
    word-break: normal;
  }

  /* Keep dates compact and unwrapped */
  .weekly-report-table thead th.date-col,
  .weekly-report-table tbody td.date-col {
    white-space: nowrap;
  }

  /* Ticket # column — keep narrow and unwrapped */
  .weekly-report-table thead th.ticket-col,
  .weekly-report-table tbody td.ticket-col {
    white-space: nowrap;
    width: 1%;
  }

  /* Account-holder columns — wrap headers across 2 lines without overflowing */
  .weekly-report-table thead th.holder-col {
    max-width: 8em;
  }
</style>
